# Homebrew dependencies for the WiVRn server, Monado and the encoder (README "Requirements").
# The Vulkan loader, headers and glslc come from the LunarG Vulkan SDK in /usr/local (universal, needed by the x86_64
# runtime slice); molten-vk is the ICD the server uses at run time (bundled into the install tree).
brew "cmake"
brew "ninja"
brew "pkg-config"
brew "eigen"
brew "jsoncpp"
brew "molten-vk"
brew "glib"
brew "boost"
brew "nlohmann-json"
brew "openssl"
brew "libarchive"
brew "librsvg"
brew "cli11"
brew "libpng"
brew "x264"

# wivrn-dashboard (WiVRn.app); the other KDE frameworks come from scripts/build-dashboard-deps.sh
brew "qt"
brew "dbus"
brew "extra-cmake-modules"
brew "ki18n"
brew "karchive"
brew "gettext"
