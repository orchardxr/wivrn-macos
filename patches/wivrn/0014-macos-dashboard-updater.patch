diff --git a/dashboard/updater.cpp b/dashboard/updater.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a414cbca2edff2c6c2e0c9668334612d95a653fd
--- /dev/null
+++ b/dashboard/updater.cpp
@@ -0,0 +1,271 @@
+/*
+ * WiVRn VR streaming
+ * Copyright (C) 2026  wivrn-macos contributors
+ *
