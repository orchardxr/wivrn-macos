+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "updater.h"
+
+#include <KLocalizedString>
+#include <QCoreApplication>
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkReply>
+#include <QProcess>
+#include <QStringList>
+#include <algorithm>
+#include <memory>
+
+#ifdef __APPLE__
+#include <CoreFoundation/CoreFoundation.h>
+#include <unistd.h>
+#endif
+
+namespace
+{
+QString repo()
+{
+	if (QString r = qEnvironmentVariable("WIVRN_UPDATE_REPO"); not r.isEmpty())
+		return r;
+	return "orchardxr/wivrn-macos";
+}
+
+// WiVRn.app, if the dashboard runs from one
+QString app_bundle()
+{
+	QDir dir(QCoreApplication::applicationDirPath());
+	if (not dir.cdUp() or not dir.cdUp() or not dir.absolutePath().endsWith(".app"))
+		return {};
+	return dir.absolutePath();
+}
+
+#ifdef __APPLE__
+QString cf_string(CFTypeRef v)
+{
+	if (not v or CFGetTypeID(v) != CFStringGetTypeID())
+		return {};
+	return QString::fromCFString(static_cast<CFStringRef>(v));
+}
+
+struct bundle_info
+{
+	QString id;
+	QString version;
+};
+
+bundle_info read_bundle(const QString & path)
+{
+	bundle_info info;
+	CFURLRef url = CFURLCreateFromFileSystemRepresentation(nullptr, reinterpret_cast<const UInt8 *>(path.toUtf8().constData()), path.toUtf8().size(), true);
+	if (not url)
+		return info;
+	if (CFBundleRef b = CFBundleCreate(nullptr, url))
+	{
+		info.id = cf_string(CFBundleGetIdentifier(b));
+		info.version = cf_string(CFBundleGetValueForInfoDictionaryKey(b, CFSTR("CFBundleShortVersionString")));
+		CFRelease(b);
+	}
+	CFRelease(url);
+	return info;
+}
+
+bundle_info main_bundle()
+{
+	bundle_info info;
+	if (CFBundleRef b = CFBundleGetMainBundle())
+	{
+		info.id = cf_string(CFBundleGetIdentifier(b));
+		info.version = cf_string(CFBundleGetValueForInfoDictionaryKey(b, CFSTR("CFBundleShortVersionString")));
+	}
+	return info;
+}
+#endif
+} // namespace
+
+updater::updater(QObject * parent) :
+        QObject(parent)
+{
+}
+
+bool updater::supported() const
+{
+#ifdef __APPLE__
+	return not app_bundle().isEmpty() and not main_bundle().id.isEmpty();
+#else
+	return false;
+#endif
+}
+
+QString updater::currentVersion() const
+{
+#ifdef __APPLE__
+	if (QString v = main_bundle().version; not v.isEmpty())
+		return v;
+#endif
+	return "0";
+}
+
+bool updater::is_newer(const QString & a, const QString & b)
+{
+	auto x = a.split('.'), y = b.split('.');
+	for (qsizetype i = 0; i < std::max(x.size(), y.size()); ++i)
+	{
+		int l = i < x.size() ? x[i].toInt() : 0;
+		int r = i < y.size() ? y[i].toInt() : 0;
+		if (l != r)
+			return l > r;
+	}
+	return false;
+}
+
+void updater::set_state(State s, const QString & message)
+{
+	if (s == State::UpToDate)
+		qInfo().noquote() << "update: checked," << currentVersion() << "is current";
+	else if (s == State::Available)
+		qInfo().noquote() << "update:" << m_latest << "available";
+	else if (s == State::Error)
+		qWarning().noquote() << "update:" << message;
+
+	// The check at startup only speaks up when there is an update
+	if (m_quiet and (s == State::UpToDate or s == State::Error))
+		s = State::Idle;
+	m_state = s;
+	m_message = message;
+	Q_EMIT stateChanged();
+}
+
+void updater::check(bool quiet)
+{
+	if (not supported() or m_state == State::Checking or m_state == State::Downloading or m_state == State::Installing)
+		return;
+	m_quiet = quiet;
+	set_state(State::Checking, i18n("Checking for updates…"));
+
+	QNetworkRequest req(QUrl("https://api.github.com/repos/" + repo() + "/releases/latest"));
+	req.setRawHeader("Accept", "application/vnd.github+json");
+	req.setHeader(QNetworkRequest::UserAgentHeader, "WiVRn-dashboard/" + currentVersion());
+	auto reply = nam.get(req);
+	connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+		reply->deleteLater();
+		int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (code == 404)
+			return set_state(State::UpToDate, i18n("No release published yet"));
+		if (reply->error() != QNetworkReply::NoError or code != 200)
+			return set_state(State::Error, i18n("Update check failed: %1", reply->errorString()));
+
+		auto r = QJsonDocument::fromJson(reply->readAll()).object();
+		if (r["draft"].toBool() or r["prerelease"].toBool())
+			return set_state(State::UpToDate, i18n("WiVRn %1 is up to date", currentVersion()));
+		QString tag = r["tag_name"].toString();
+		m_latest = tag.startsWith('v') ? tag.mid(1) : tag;
+		m_page = QUrl(r["html_url"].toString());
+		m_zip.clear();
+		for (const auto & a: r["assets"].toArray())
+		{
+			auto name = a.toObject()["name"].toString();
+			if (name.startsWith("WiVRn-") and name.endsWith(".zip"))
+				m_zip = QUrl(a.toObject()["browser_download_url"].toString());
+		}
+		if (m_zip.isEmpty() or not is_newer(m_latest, currentVersion()))
+			return set_state(State::UpToDate, i18n("WiVRn %1 is up to date", currentVersion()));
+		set_state(State::Available, i18n("WiVRn %1 is available (installed: %2)", m_latest, currentVersion()));
+	});
+}
+
+void updater::install()
+{
+#ifdef __APPLE__
+	if (m_state != State::Available)
+		return;
+	m_quiet = false;
+	QString installed = app_bundle();
+	if (not QFileInfo(QFileInfo(installed).absolutePath()).isWritable())
+		return set_state(State::Error, i18n("Cannot replace %1: its folder is not writable. Download the update from the release page.", installed));
+
+	QString dir = QDir::tempPath() + "/wivrn-update-" + m_latest;
+	QDir(dir).removeRecursively();
+	QDir().mkpath(dir);
+	auto file = std::make_shared<QFile>(dir + "/WiVRn.zip");
+	if (not file->open(QFile::WriteOnly))
+		return set_state(State::Error, i18n("Cannot write %1", file->fileName()));
+
+	set_state(State::Downloading, i18n("Downloading WiVRn %1…", m_latest));
+	QNetworkRequest req(m_zip);
+	req.setHeader(QNetworkRequest::UserAgentHeader, "WiVRn-dashboard/" + currentVersion());
+	auto reply = nam.get(req);
+	connect(reply, &QNetworkReply::readyRead, this, [reply, file]() { file->write(reply->readAll()); });
+	connect(reply, &QNetworkReply::downloadProgress, this, [this](qint64 got, qint64 total) {
+		if (total > 0)
+			set_state(State::Downloading, i18n("Downloading WiVRn %1… %2%", m_latest, got * 100 / total));
+	});
+	connect(reply, &QNetworkReply::finished, this, [this, reply, file]() {
+		reply->deleteLater();
+		file->write(reply->readAll());
+		file->close();
+		int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+		if (reply->error() != QNetworkReply::NoError or code != 200)
+			return set_state(State::Error, i18n("Download failed: %1", reply->errorString()));
+		unpack(file->fileName());
+	});
+#endif
+}
+
+void updater::unpack(const QString & zip)
+{
+#ifdef __APPLE__
+	set_state(State::Installing, i18n("Checking WiVRn %1…", m_latest));
+	QString dir = QFileInfo(zip).absolutePath();
+	auto ditto = new QProcess(this);
+	connect(ditto, &QProcess::finished, this, [this, ditto, dir, zip](int status) {
+		ditto->deleteLater();
+		QFile::remove(zip);
+		if (status != 0)
+			return set_state(State::Error, i18n("Unpacking the update failed"));
+
+		QString app = dir + "/WiVRn.app";
+		auto info = read_bundle(app);
+		if (info.id != main_bundle().id or info.version != m_latest)
+			return set_state(State::Error, i18n("The release has no matching WiVRn.app (found %1 %2)", info.id, info.version));
+
+		auto codesign = new QProcess(this);
+		connect(codesign, &QProcess::finished, this, [this, codesign, app](int status) {
+			codesign->deleteLater();
+			if (status != 0)
+				return set_state(State::Error, i18n("Signature check failed: %1", QString::fromUtf8(codesign->readAllStandardError()).trimmed()));
+
+			// After we exit: swap the bundles (restoring the old one on failure) and open the result
+			const char * script = R"(while kill -0 "$1" 2>/dev/null; do sleep 0.2; done
+old="$2.old-update"
+rm -rf "$old"
+if mv "$2" "$old"; then
+	if mv "$3" "$2"; then rm -rf "$old"; else mv "$old" "$2"; fi
+fi
+xattr -dr com.apple.quarantine "$2" 2>/dev/null
+open "$2")";
+			if (not QProcess::startDetached("/bin/sh", {"-c", script, "sh", QString::number(getpid()), app_bundle(), app}))
+				return set_state(State::Error, i18n("Cannot start the installer"));
+			QCoreApplication::quit();
+		});
+		codesign->start("/usr/bin/codesign", {"--verify", "--deep", "--strict", app});
+	});
+	ditto->start("/usr/bin/ditto", {"-x", "-k", zip, dir});
+#endif
+}
