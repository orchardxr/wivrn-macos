+#pragma once
+
+#include <QNetworkAccessManager>
+#include <QObject>
+#include <QString>
+#include <QUrl>
+#include <QtQml/qqmlregistration.h>
+
+// Self-update of WiVRn.app from the GitHub releases of orchardxr/wivrn-macos
+class updater : public QObject
+{
+	Q_OBJECT
+	QML_NAMED_ELEMENT(Updater)
+	QML_SINGLETON
+
+public:
+	enum class State
+	{
+		Idle,
+		Checking,
+		UpToDate,
+		Available,
+		Downloading,
+		Installing,
+		Error,
+	};
+	Q_ENUM(State)
+
+	Q_PROPERTY(bool supported READ supported CONSTANT)
+	Q_PROPERTY(State state READ state NOTIFY stateChanged)
+	Q_PROPERTY(QString message READ message NOTIFY stateChanged)
+	Q_PROPERTY(QString currentVersion READ currentVersion CONSTANT)
+	Q_PROPERTY(QString latestVersion READ latestVersion NOTIFY stateChanged)
+	Q_PROPERTY(QUrl releasePage READ releasePage NOTIFY stateChanged)
+
+	updater(QObject * parent = nullptr);
+
+	bool supported() const;
+	State state() const
+	{
+		return m_state;
+	}
+	QString message() const
+	{
+		return m_message;
+	}
+	QString currentVersion() const;
+	QString latestVersion() const
+	{
+		return m_latest;
+	}
+	QUrl releasePage() const
+	{
+		return m_page;
+	}
+
+	static bool is_newer(const QString & a, const QString & b);
+
+	Q_INVOKABLE void check(bool quiet = false);
+	Q_INVOKABLE void install();
+
+Q_SIGNALS:
+	void stateChanged();
+
+private:
+	void set_state(State s, const QString & message = {});
+	void unpack(const QString & zip);
+
+	QNetworkAccessManager nam;
+	State m_state = State::Idle;
+	QString m_message;
+	QString m_latest;
+	QUrl m_zip;
+	QUrl m_page;
+	bool m_quiet = false;
+};
