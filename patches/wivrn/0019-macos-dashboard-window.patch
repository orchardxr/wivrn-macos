+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QWindow>
+#include <QtQml/qqmlregistration.h>
+
+class window_helper : public QObject
+{
+	Q_OBJECT
+	QML_NAMED_ELEMENT(WindowHelper)
+	QML_SINGLETON
+
+public:
+	using QObject::QObject;
+
+	// Activates the app, then shows, unminimises and raises the window; on macOS from a full-screen Space the system
+	// switches to the desktop and the window is there
+	Q_INVOKABLE static void bringToFront(QWindow * window);
+
+#ifdef __APPLE__
+	// The close button hides the window; opening the running app again from Finder or Spotlight
+	// (kAEReopenApplication) brings it to front
+	static void show_on_reopen(QWindow * window);
+#endif
+};
diff --git a/dashboard/window_helper_macos.mm b/dashboard/window_helper_macos.mm
new file mode 100644
index 0000000000000000000000000000000000000000..852ea3e6bce505bf0ec66fedbc8ec8904e5abc76
--- /dev/null
+++ b/dashboard/window_helper_macos.mm
@@ -0,0 +1,75 @@
+/*
+ * WiVRn VR streaming
+ * Copyright (C) 2026  wivrn-macos contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "window_helper.h"
+
+#include <QDebug>
+#include <QEvent>
+#include <QPointer>
+
+#import <AppKit/AppKit.h>
+
+void macos_activate_app(QWindow * window)
+{
+	// Shown again right away, a window on another Space comes up on the one macOS switches to
+	if (window->isVisible() and not reinterpret_cast<NSView *>(window->winId()).window.onActiveSpace)
+		window->hide();
+	[NSApp activateIgnoringOtherApps:YES];
+}
+
+// The close button hides the window instead. A closed window is destroyed, and a menu-bar-only app's new window opens
+// on the active Space, also over a full-screen app; a hidden one comes back on its desktop. Quit and logout close the
+// window programmatically (not spontaneously), so they still go through.
+class hide_on_close : public QObject
+{
+public:
+	using QObject::QObject;
+	bool eventFilter(QObject * watched, QEvent * event) override
+	{
+		if (event->type() != QEvent::Close or not event->spontaneous())
+			return false;
+		event->ignore();
+		static_cast<QWindow *>(watched)->hide();
+		return true;
+	}
+};
+
+@interface WivrnReopenHandler : NSObject
+@property QPointer<QWindow> window;
+@end
+
+@implementation WivrnReopenHandler
+- (void)handleReopen:(NSAppleEventDescriptor *)event withReply:(NSAppleEventDescriptor *)reply
+{
+	qInfo() << "Reopen: showing the window";
+	window_helper::bringToFront(self.window);
+}
+@end
+
+// Qt only activates the app on reopen, so a closed window stayed hidden
+void window_helper::show_on_reopen(QWindow * window)
+{
+	window->installEventFilter(new hide_on_close(window));
+
+	static WivrnReopenHandler * handler = [WivrnReopenHandler new];
+	handler.window = window;
+	[[NSAppleEventManager sharedAppleEventManager] setEventHandler:handler
+	                                                   andSelector:@selector(handleReopen:withReply:)
+	                                                 forEventClass:kCoreEventClass
+	                                                    andEventID:kAEReopenApplication];
+}
