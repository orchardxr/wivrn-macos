+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QWindow>
+#include <QtQml/qqmlregistration.h>
+
+class window_helper : public QObject
+{
+	Q_OBJECT
+	QML_NAMED_ELEMENT(WindowHelper)
+	QML_SINGLETON
+
+public:
+	using QObject::QObject;
+
+	// Shows, unminimises and raises the window and activates the app; on macOS the system then switches to the
+	// window's Space, also from another app's full-screen Space
+	Q_INVOKABLE static void bringToFront(QWindow * window);
+
+#ifdef __APPLE__
+	// Dock icon click or opening the running app (kAEReopenApplication): bring the window to front
+	static void show_on_reopen(QWindow * window);
+#endif
+};
diff --git a/dashboard/window_helper_macos.mm b/dashboard/window_helper_macos.mm
new file mode 100644
index 0000000000000000000000000000000000000000..513ca033758ad9043b3657defb22c53134637774
