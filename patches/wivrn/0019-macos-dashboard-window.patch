+
+#ifdef __APPLE__
+void macos_activate_app(QWindow * window);
+#endif
+
+void window_helper::bringToFront(QWindow * window)
+{
+	if (not window)
+		return;
+#ifdef __APPLE__
+	// Activate first, so the window ends up on the Space macOS switches to
+	macos_activate_app(window);
+#endif
+	if (window->windowState() & Qt::WindowMinimized)
+		window->showNormal();
+	else
+		window->show();
+	window->raise();
+	window->requestActivate();
+}
diff --git a/dashboard/window_helper.h b/dashboard/window_helper.h
new file mode 100644
index 0000000000000000000000000000000000000000..e87acc88fd73b6f20af9f7894f646f8dee671cd2
--- /dev/null
+++ b/dashboard/window_helper.h
@@ -0,0 +1,43 @@
+/*
+ * WiVRn VR streaming
+ * Copyright (C) 2026  wivrn-macos contributors
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
