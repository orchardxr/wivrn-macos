diff --git a/dashboard/main.cpp b/dashboard/main.cpp
index a63faf24c1981a2c8bdbfebef99e54e1dc739993..464343670454a5a098c61016c4c60cc1c736fb55 100644
--- a/dashboard/main.cpp
+++ b/dashboard/main.cpp
@@ -31,6 +31,8 @@
 #include <unistd.h>
 
 #include "dashboard_utils.h"
+#include "window_helper.h"
+#include <QTimer>
 
 // macOS has no session bus: run a private one in the user temp dir, shared with the servers we start
 struct stop_process
@@ -261,6 +263,12 @@ int main(int argc, char * argv[])
 	{
 		return -1;
 	}
+#ifdef __APPLE__
+	// Closing the window leaves WiVRn in the menu bar
+	app.setQuitOnLastWindowClosed(false);
+	if (auto window = qobject_cast<QWindow *>(engine.rootObjects().first()))
+		QTimer::singleShot(0, window, [window] { window_helper::show_on_reopen(window); });
+#endif
 
 	return app.exec();
 }
diff --git a/dashboard/qml/Main.qml b/dashboard/qml/Main.qml
index 4307d4197b3bd740ea7947c8972eeca432e97dc1..f79630d29d976e64a6c46410acc228db46286882 100644
--- a/dashboard/qml/Main.qml
+++ b/dashboard/qml/Main.qml
@@ -19,7 +19,50 @@ Kirigami.ApplicationWindow {
         id: systray
         visible: true
         icon.source: Qt.resolvedUrl("wivrn.svg")
-        onActivated: root.visible = !root.visible
+        // On macOS a click on the menu-bar item opens its menu
+        onActivated: if (Qt.platform.os != "osx") root.visible = !root.visible
+        menu: Qt.platform.os == "osx" ? systray_menu : null
+    }
+
+    Menu {
+        id: systray_menu
+        MenuItem {
+            enabled: false
+            text: {
+                switch (WivrnServer.serverStatus) {
+                case WivrnServer.Started:
+                    return WivrnServer.headsetConnected ? i18n("Headset connected") : i18n("Server running");
+                case WivrnServer.Starting:
+                case WivrnServer.Restarting:
+                    return i18n("Server starting");
+                case WivrnServer.Stopping:
+                    return i18n("Server stopping");
+                case WivrnServer.FailedToStart:
+                    return i18n("Server failed to start");
+                default:
+                    return i18n("Server stopped");
+                }
+            }
+        }
+        MenuSeparator {}
+        MenuItem {
+            text: i18n("Show WiVRn")
+            onTriggered: WindowHelper.bringToFront(root)
+        }
+        MenuSeparator {}
+        MenuItem {
+            text: i18n("Quit WiVRn")
+            onTriggered: root.request_quit()
+        }
+    }
+
+    function request_quit() {
+        if (WivrnServer.ownServer && WivrnServer.sessionRunning) {
+            WindowHelper.bringToFront(root);
+            confirm_close.open();
+        } else {
+            Qt.quit();
+        }
     }
 
     Component{
@@ -37,6 +80,9 @@ Kirigami.ApplicationWindow {
     }
 
     onClosing: (close) => {
+        // On macOS the window closes to the menu bar, which has Quit
+        if (Qt.platform.os == "osx")
+            return;
         if (WivrnServer.ownServer && WivrnServer.sessionRunning)
         {
             close.accepted = false;
