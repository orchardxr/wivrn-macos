+#include "window_helper.h"
+
+#ifdef __APPLE__
+void macos_activate_app();
+#endif
+
+void window_helper::bringToFront(QWindow * window)
+{
+	if (not window)
+		return;
+	if (window->windowState() & Qt::WindowMinimized)
+		window->showNormal();
+	else
+		window->show();
+	window->raise();
+	window->requestActivate();
+#ifdef __APPLE__
+	macos_activate_app();
+#endif
+}
diff --git a/dashboard/window_helper.h b/dashboard/window_helper.h
new file mode 100644
index 0000000000000000000000000000000000000000..2c2f5e0006e911010955fda3f6370b506aa81315
--- /dev/null
+++ b/dashboard/window_helper.h
@@ -0,0 +1,42 @@
+/*
