From: wivrn-macos
Subject: [PATCH] macos-dashboard-window

---
 dashboard/CMakeLists.txt         |  4 +++-
 dashboard/main.cpp               |  6 +++++
 dashboard/qml/Main.qml           | 45 +++++++++++++++++++++++++++++++++-
 dashboard/window_helper.cpp      | 38 +++++++++++++++++++++++++++++
 dashboard/window_helper.h        | 42 ++++++++++++++++++++++++++++++++
 dashboard/window_helper_macos.mm | 52 ++++++++++++++++++++++++++++++++++++++++
 6 files changed, 185 insertions(+), 2 deletions(-)

diff --git a/dashboard/CMakeLists.txt b/dashboard/CMakeLists.txt
index f34aacbef27760c30df268cad29e8457a06f02f4..6718f5884501e93e7cf96ee4077fed5236fdf1e6 100644
--- a/dashboard/CMakeLists.txt
+++ b/dashboard/CMakeLists.txt
@@ -28,6 +28,7 @@ add_executable(wivrn-dashboard
     firewall.cpp
     vulkan_info.cpp
     updater.cpp
+    window_helper.cpp
 )
 
 set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/../dbus/io.github.wivrn.Server.xml PROPERTIES INCLUDE "${CMAKE_CURRENT_SOURCE_DIR}/wivrn_qdbus_types.h")
@@ -93,7 +94,8 @@ target_link_libraries(wivrn-dashboard
 )
 
 if(APPLE)
-    target_link_libraries(wivrn-dashboard PRIVATE "-framework SystemConfiguration" "-framework CoreFoundation")
+    target_sources(wivrn-dashboard PRIVATE window_helper_macos.mm)
+    target_link_libraries(wivrn-dashboard PRIVATE "-framework SystemConfiguration" "-framework CoreFoundation" "-framework AppKit")
 endif()
 
 install(TARGETS wivrn-dashboard ${KDE_INSTALL_TARGETS_DEFAULT_ARGS})
diff --git a/dashboard/main.cpp b/dashboard/main.cpp
index 212ccc2ab8d76453c4e1b34f13cc9dcaa672932d..4237bea2c206cd0186528ba7602df975d67d0ba6 100644
--- a/dashboard/main.cpp
+++ b/dashboard/main.cpp
@@ -28,6 +28,8 @@
 #include <unistd.h>
 
 #include "dashboard_utils.h"
+#include "window_helper.h"
+#include <QTimer>
 
 // macOS has no session bus: run a private one in the user temp dir, shared with the servers we start
 struct stop_process
@@ -236,6 +238,10 @@ int main(int argc, char * argv[])
 	{
 		return -1;
 	}
+#ifdef __APPLE__
+	if (auto window = qobject_cast<QWindow *>(engine.rootObjects().first()))
+		QTimer::singleShot(0, window, [window] { window_helper::show_on_reopen(window); });
+#endif
 
 	return app.exec();
 }
diff --git a/dashboard/qml/Main.qml b/dashboard/qml/Main.qml
index 4307d4197b3bd740ea7947c8972eeca432e97dc1..a024adc2d695ca9966ea83a1d99188cd9857a3d0 100644
--- a/dashboard/qml/Main.qml
+++ b/dashboard/qml/Main.qml
@@ -19,7 +19,50 @@ Kirigami.ApplicationWindow {
         id: systray
         visible: true
         icon.source: Qt.resolvedUrl("wivrn.svg")
-        onActivated: root.visible = !root.visible
+        // On macOS a click on the menu-bar item opens its menu
+        onActivated: if (Qt.platform.os != "osx") root.visible = !root.visible
+        menu: Qt.platform.os == "osx" ? systray_menu : null
+    }
+
+    Menu {
+        id: systray_menu
+        MenuItem {
+            enabled: false
+            text: {
+                switch (WivrnServer.serverStatus) {
+                case WivrnServer.Started:
+                    return WivrnServer.headsetConnected ? i18n("Headset connected") : i18n("Server running");
+                case WivrnServer.Starting:
+                case WivrnServer.Restarting:
+                    return i18n("Server starting");
+                case WivrnServer.Stopping:
+                    return i18n("Server stopping");
+                case WivrnServer.FailedToStart:
+                    return i18n("Server failed to start");
+                default:
+                    return i18n("Server stopped");
+                }
+            }
+        }
+        MenuSeparator {}
+        MenuItem {
+            text: i18n("Show WiVRn")
+            onTriggered: WindowHelper.bringToFront(root)
+        }
+        MenuSeparator {}
+        MenuItem {
+            text: i18n("Quit WiVRn")
+            onTriggered: root.request_quit()
+        }
+    }
+
+    function request_quit() {
+        if (WivrnServer.ownServer && WivrnServer.sessionRunning) {
+            WindowHelper.bringToFront(root);
+            confirm_close.open();
+        } else {
+            Qt.quit();
+        }
     }
 
     Component{
