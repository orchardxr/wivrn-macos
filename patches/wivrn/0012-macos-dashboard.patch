diff --git a/dashboard/main.cpp b/dashboard/main.cpp
index 297b77dcba967924c153a4d1b86092749b26242a..e9bece5e69cce0d3f0ec1ca9bea5588be665fbc6 100644
--- a/dashboard/main.cpp
+++ b/dashboard/main.cpp
@@ -14,10 +14,100 @@
 #include <QQuickWindow>
 #include <QStringLiteral>
 
+#ifdef __APPLE__
+#include <QDBusConnection>
+#include <QDir>
+#include <QFile>
+#include <QProcess>
+#include <QStandardPaths>
+#include <unistd.h>
+
+// macOS has no session bus: run a private one in the user temp dir, shared with the servers we start
+struct stop_process
+{
+	void operator()(QProcess * p)
+	{
+		p->terminate();
+		p->waitForFinished(1000);
+		delete p;
+	}
+};
+
+static std::unique_ptr<QProcess, stop_process> start_session_bus()
+{
+	if (qEnvironmentVariableIsSet("DBUS_SESSION_BUS_ADDRESS"))
+		return {};
+
+	char tmp[PATH_MAX];
+	QString dir = (confstr(_CS_DARWIN_USER_TEMP_DIR, tmp, sizeof(tmp)) > 0 ? QString(tmp) : QDir::tempPath() + "/") + "wivrn";
+	QDir().mkpath(dir);
+	QString socket = dir + "/dbus-session";
+	QString address = "unix:path=" + socket;
+	qputenv("DBUS_SESSION_BUS_ADDRESS", address.toUtf8());
+
+	{
+		auto probe = QDBusConnection::connectToBus(address, "wivrn-probe");
+		bool running = probe.isConnected();
+		QDBusConnection::disconnectFromBus("wivrn-probe");
+		if (running)
+			return {};
+	}
+	QFile::remove(socket);
+
+	QString config = dir + "/dbus-session.conf";
+	if (QFile f(config); f.open(QFile::WriteOnly | QFile::Truncate))
+		f.write(R"(<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <type>session</type>
+  <keep_umask/>
+  <listen>unix:tmpdir=/tmp</listen>
+  <auth>EXTERNAL</auth>
+  <policy context="default">
+    <allow send_destination="*" eavesdrop="true"/>
+    <allow eavesdrop="true"/>
+    <allow own="*"/>
+  </policy>
+</busconfig>
+)");
+
+	QString daemon = QCoreApplication::applicationDirPath() + "/dbus-daemon";
+	if (not QFileInfo::exists(daemon))
+		daemon = QStandardPaths::findExecutable("dbus-daemon", {"/opt/homebrew/opt/dbus/bin", "/usr/local/opt/dbus/bin"});
+
+	std::unique_ptr<QProcess, stop_process> bus{new QProcess};
+	bus->setProcessChannelMode(QProcess::ForwardedErrorChannel);
+	bus->start(daemon, {"--nofork", "--print-address", "--config-file=" + config, "--address=" + address});
+	if (not bus->waitForReadyRead(5000))
+		qWarning() << "Failed to start" << daemon << bus->errorString();
+	return bus;
+}
+
+// MoltenVK for the dashboard and the server: the bundled ICD, else Homebrew's
+static void set_vulkan_driver()
+{
+	if (qEnvironmentVariableIsSet("VK_DRIVER_FILES") or qEnvironmentVariableIsSet("VK_ICD_FILENAMES"))
+		return;
+	for (const QString & icd: {QCoreApplication::applicationDirPath() + "/../Resources/vulkan/icd.d/MoltenVK_icd.json",
+	                           QString("/opt/homebrew/opt/molten-vk/etc/vulkan/icd.d/MoltenVK_icd.json")})
+	{
+		if (QFileInfo::exists(icd))
+		{
+			qputenv("VK_DRIVER_FILES", QFileInfo(icd).canonicalFilePath().toUtf8());
+			return;
+		}
+	}
+}
+#endif
+
 int main(int argc, char * argv[])
 {
 	KIconTheme::initTheme();
 	QApplication app(argc, argv);
+#ifdef __APPLE__
+	auto session_bus = start_session_bus();
+	set_vulkan_driver();
+#endif
 	KLocalizedString::setApplicationDomain("wivrn-dashboard");
 	app.setOrganizationName(QStringLiteral("wivrn"));
 
@@ -51,11 +141,17 @@ int main(int argc, char * argv[])
 	// Work around QTBUG-45105, QTBUG-46074, QTBUG-51112: flicker when resizing
 	QQuickWindow::setSceneGraphBackend(QString::fromLatin1("software"));
 
+#ifndef __APPLE__
 	QApplication::setStyle(QStringLiteral("breeze"));
 	if (qEnvironmentVariableIsEmpty("QT_QUICK_CONTROLS_STYLE"))
 	{
 		QQuickStyle::setStyle(QStringLiteral("org.kde.desktop"));
 	}
+#else
+	// Kirigami's pages and toolbars draw badly with the native macOS style
+	if (qEnvironmentVariableIsEmpty("QT_QUICK_CONTROLS_STYLE"))
+		QQuickStyle::setStyle(QStringLiteral("Fusion"));
+#endif
 
 	QQmlApplicationEngine engine;
 
