diff --git a/dashboard/qml/WizardPage.qml b/dashboard/qml/WizardPage.qml
index 3873d3e42ad4c3ff5c5a3fbde3850fe47f05b09e..14e150818d15bec11bb408bcbe8b4f3fdb4b1757 100644
