 4 files changed, 94 insertions(+), 4 deletions(-)

diff --git a/common/utils/openvr_compat.h b/common/utils/openvr_compat.h
new file mode 100644
index 0000000000000000000000000000000000000000..e0d06418d0d28fcf5d6ff1ff7910510dfc93e441
--- /dev/null
+++ b/common/utils/openvr_compat.h
@@ -0,0 +1,64 @@
+/*
