                 Controls.ComboBox {
                     id: encoder_combo
-                    model: [
+                    model: Qt.platform.os == "osx" ? [
+                        {
+                            label: i18nc("automatic encoder setup", "Auto"),
+                            encoder: Settings.EncoderAuto
+                        },
+                        {
+                            label: i18n("VideoToolbox (hardware encoding)"),
+                            encoder: Settings.VideoToolbox
+                        }
+                    ].concat(Settings.x264_supported ? [
+                        {
+                            label: i18n("x264 (software encoding)"),
+                            encoder: Settings.X264
+                        }
+                    ] : []) : [
                         {
                             label: i18nc("automatic encoder setup", "Auto"),
                             encoder: Settings.EncoderAuto
